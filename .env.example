# Flask
SECRET_KEY=change-this-to-a-long-random-string

# MongoDB Atlas — get this from your cluster's "Connect" > "Drivers" screen
# (dashboard.cloud.mongodb.com -> your cluster -> Connect)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=jennie_hairport

# Admin panel login (single shared password, like the reference site)
ADMIN_PASSWORD=jennie-admin-2026

# Squad (squadco.com) payment gateway
# Get real keys from your Squad dashboard: https://dashboard.squadco.com
SQUAD_SECRET_KEY=sandbox_sk_replace_with_real_key
SQUAD_PUBLIC_KEY=sandbox_pk_replace_with_real_key
SQUAD_ENV=sandbox
# Public base URL of this site, used to build Squad's callback_url
SITE_BASE_URL=http://localhost:5000
